[Desktop Entry]
Type=Application
Name=Slapt-update-notifier
GenericName=Slapt update notification service
GenericName[ru]=Сервис уведомления обновлений Slapt
GenericName[uk]=Сервіс повідомлення оновлень Slapt
Comment=Checks for system package upgrades
Comment[ru]=Проверка обновлений системных пакетов
Comment[uk]=Перевірка оновлень системних пакетів
Exec=/usr/bin/slapt-update-notifier
StartupNotify=false
Terminal=false
Hidden=false
